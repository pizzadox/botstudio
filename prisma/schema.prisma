generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions  Session[]
  bots      Bot[]
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model Bot {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  status        String          @default("draft")
  flow          String          @default("{}")
  /// Настройки ИИ-ассистента: { enabled, prompt, reaskMenu }
  aiConfig      String          @default("{}")
  /// Настройки интеграции MyTKO: { enabled, apiUrl, username, password, lkCodes, token, tokenIssuedAt, directions, useAllAreas, areasSyncedAt }
  mytkoConfig   String          @default("{}")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  channels      Channel[]
  conversations Conversation[]
  knowledge     KnowledgeItem[]
  orders        Order[]
  /// Жалобы клиентов (не вывезли / повреждён контейнер / переполнена площадка / другая)
  complaints    Complaint[]
  /// Реестр КП (контейнерных площадок), загруженный из MyTKO — «все возможные КОДЫ КП»
  mytkoAreas    MytkoArea[]

  @@index([userId, updatedAt])
}

/// Контейнерная площадка из реестра MyTKO (кэш справочника КП проекта)
model MytkoArea {
  id        String   @id @default(cuid())
  botId     String
  bot       Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  /// Код КП (lk_code), например 53900003
  lkCode    String
  /// Полный адрес площадки (address.view из MyTKO)
  address   String?
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([botId, lkCode])
  /// IMP-23-BE-10: сортировка/поиск реестра КП (address asc, null last)
  @@index([botId, address])
}

model Channel {
  id            String         @id @default(cuid())
  botId         String
  bot           Bot            @relation(fields: [botId], references: [id], onDelete: Cascade)
  type          String
  title         String
  token         String?
  phone         String?
  secret        String         @unique @default(cuid())
  active        Boolean        @default(true)
  lastStatus    String?
  createdAt     DateTime       @default(now())
  conversations Conversation[]

  @@index([botId])
}

model Conversation {
  id             String    @id @default(cuid())
  botId          String
  bot            Bot       @relation(fields: [botId], references: [id], onDelete: Cascade)
  channelId      String?
  channel        Channel?  @relation(fields: [channelId], references: [id], onDelete: SetNull)
  source         String    @default("web")
  /// Куда отвечать в мессенджере (для MAX — chat_id диалога)
  externalId     String?
  /// Стабильный идентификатор человека (для MAX — user_id): один пользователь = одно обращение
  externalUserId String?
  contact        String?
  state          String?
  needsOperator  Boolean   @default(false)
  status         String    @default("open")
  /// Когда оператор последний раз открывал диалог — для счётчика непрочитанных
  operatorReadAt DateTime?
  /// Закреплён ли диалог оператором (IMP-BE22-12b): не-null → закреплён, поднимается вверху инбокса
  pinnedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  messages       Message[]
  orders         Order[]
  /// IMP-23-BE-01: жалобы, зарегистрированные в этом диалоге (сценарием бота)
  complaints     Complaint[]

  @@unique([botId, source, externalId])
  @@index([botId, source, externalUserId])
  @@index([botId, updatedAt])
  @@index([botId, status])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  text           String
  nodeId         String?
  /// Ключ входящего сообщения мессенджера (mid / callback_id) — защита от повторной обработки
  externalKey    String?
  /// Сообщение относится к конкретной заявке (чат по заявке)
  orderId        String?
  order          Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  @@unique([conversationId, externalKey])
  @@index([conversationId, createdAt])
  @@index([orderId])
}

/// Заявка клиента (вывоз отходов / КГМ), создаётся сценарием бота или оператором
model Order {
  id             String        @id @default(cuid())
  botId          String
  bot            Bot           @relation(fields: [botId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  /// Стабильный идентификатор клиента в канале (MAX user_id и т.п.) — история заказов клиента
  externalUserId String?
  /// Человекочитаемый номер заявки в пределах бота (№1, №2, …)
  number         Int
  /// waste — вывоз отходов, kgm — крупногабаритный мусор, other — другое
  type           String        @default("waste")
  clientName     String?
  phone          String?
  /// Город обслуживания (выбирается в боте или оператором) — Новгородская область
  city           String?
  address        String?
  /// Объём контейнера / состав предметов
  size           String?
  /// Желаемая дата подачи машины (свободный текст из сценария)
  wishDate       String?
  comment        String?
  /// new → assigned → in_progress → completed | cancelled
  status         String        @default("new")
  assignee       String?
  /// Координаты для карты (OpenFreeMap); заполняются геокодингом или оператором
  lat            Float?
  lng            Float?
  /// Как получены координаты: manual — оператор указал на карте, geocode — по адресу
  geoSource      String?
  /// Синхронизация с MyTKO: synced — данные сверены, error — ошибка связи; null — не синхронизировано
  mytkoStatus    String?
  mytkoSyncAt    DateTime?
  /// Краткая сводка из MyTKO (например, машина и факт вывоза)
  mytkoInfo      String?
  /// Текст последней ошибки синхронизации
  mytkoError     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  completedAt    DateTime?
  messages       Message[]

  @@unique([botId, number])
  @@index([botId, status])
  @@index([botId, externalUserId])
  @@index([botId, createdAt])
  @@index([conversationId])
}

/// IMP-23-BE-01: жалоба клиента (проблема с вывозом), создаётся сценарием бота
/// (узел «Сообщение» с флагом createComplaint) или вручную оператором
model Complaint {
  id             String        @id @default(cuid())
  botId          String
  bot            Bot           @relation(fields: [botId], references: [id], onDelete: Cascade)
  /// Человекочитаемый номер жалобы в пределах бота (№1, №2, …)
  number         Int
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  /// no_pickup — не вывезли; damaged — повреждён контейнер;
  /// overflow — переполнена площадка; other — другое
  type           String        @default("other")
  /// new → in_review → resolved (переходы между любыми — матрица свободная)
  status         String        @default("new")
  description    String
  /// Когда произошло (со слов клиента; не парсится как дата — null)
  happenedAt     DateTime?
  /// Контакт для связи (из диалога или от оператора)
  contact        String?
  /// scenario — создана сценарием бота; manual — оператором из ЛК
  source         String        @default("scenario")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([botId, number])
  @@index([botId, status])
  @@index([botId, conversationId])
}

/// Запись базы знаний ИИ-ассистента бота
model KnowledgeItem {
  id        String   @id @default(cuid())
  botId     String
  bot       Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([botId])
}
